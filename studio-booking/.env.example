# Copy to .env (never committed). Values are read by book_studio.py and discover.py.
IPLUS_URL=https://iplus.sg
IPLUS_USERNAME=
# "password" or "otp". Vin logs in with OTP by SMS: the script never types a code. You log in
# once interactively (python3 book_studio.py --login) and the persistent profile keeps the session.
IPLUS_AUTH=otp
# Only used when IPLUS_AUTH=password. Leave blank otherwise.
IPLUS_PASSWORD=
