# Copy to .env (never committed). Values are read by book_studio.py and discover.py.
# Web portal login (found from iplusliving.com; the mobile app's SMS OTP login is separate).
IPLUS_URL=https://app.iplusliving.com/site/login
IPLUS_USERNAME=
# "password" or "otp". The web login page shows Username + Password fields. If an OTP step
# appears after the password, set otp: the script never types a code, you log in once
# interactively (python3 book_studio.py --login) and the persistent profile keeps the session.
IPLUS_AUTH=password
# Only used when IPLUS_AUTH=password. Leave blank otherwise.
IPLUS_PASSWORD=
