# ---- Focus: tracking + push engine ----
# Everything is optional. With nothing set, the board works and digests are
# generated and logged on /focus/review, just not delivered anywhere.

# Push channels (any combination; all configured channels are used)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
NOTIFY_WEBHOOK_URL=

# Protects POST /api/focus/nudge when the app is on the public internet.
# Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>" automatically.
CRON_SECRET=

# Sync sources
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=
# Comma-separated "Name=https://....ics" (Google Calendar → Settings → Secret address in iCal format)
CALENDAR_ICS_URLS=

# ---- AI desk: multi-model routing (/focus/ai) ----
# Any subset works. Each mode routes to the best configured model and falls back
# to the next one. Council uses every configured text model and merges with Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Higgsfield renders the Creative mode brief. Keys from https://cloud.higgsfield.ai/api-keys
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
HIGGSFIELD_MODEL_PATH=higgsfield-ai/soul/v2/standard

# Where the tracker database lives (defaults to data/focus.db)
FOCUS_DB_PATH=
